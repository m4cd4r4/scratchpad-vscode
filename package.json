{
  "name": "scratchpad-vscode",
  "displayName": "Scratchpad",
  "description": "A notepad in the sidebar for prompts, URLs and file paths. Click to copy. Claude can add to it and query it by date.",
  "version": "0.2.1",
  "icon": "media/icon.png",
  "publisher": "m4cd4r4",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "bin": {
    "pad": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test test/store.test.js test/extension.smoke.test.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scratchpad",
          "title": "Scratchpad",
          "icon": "media/pad.svg"
        }
      ]
    },
    "views": {
      "scratchpad": [
        {
          "id": "scratchpad.list",
          "name": "Notes",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "scratchpad.addFromClipboard",
        "title": "Scratchpad: Add from Clipboard",
        "icon": "$(clippy)"
      },
      {
        "command": "scratchpad.addFromSelection",
        "title": "Scratchpad: Add Selection"
      },
      {
        "command": "scratchpad.addPath",
        "title": "Scratchpad: Add Path"
      },
      {
        "command": "scratchpad.openFile",
        "title": "Scratchpad: Open Notes File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scratchpad.addFromClipboard",
          "when": "view == scratchpad.list",
          "group": "navigation@1"
        },
        {
          "command": "scratchpad.openFile",
          "when": "view == scratchpad.list",
          "group": "9_misc"
        }
      ],
      "explorer/context": [
        {
          "command": "scratchpad.addPath",
          "group": "6_copypath@9"
        }
      ],
      "editor/context": [
        {
          "command": "scratchpad.addFromSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@9"
        }
      ]
    },
    "configuration": {
      "title": "Scratchpad",
      "properties": {
        "scratchpad.file": {
          "type": "string",
          "default": "",
          "description": "Notes file (JSONL). Empty = ~/.claude/pad/notes.jsonl, which the /pad skill also uses."
        },
        "scratchpad.fillPlaceholders": {
          "type": "boolean",
          "default": true,
          "description": "When copying a prompt, ask for a value for each <placeholder> (Esc leaves it as is)."
        }
      }
    }
  }
}
